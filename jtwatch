def _ms_to_period(ms: int) -> str:
    """Convert a WSJT-X time_ms value to a HHMMSSZ period string."""
    hh = (ms // 3_600_000) % 24
    mm = (ms %  3_600_000) // 60_000
    ss = (ms %     60_000) //  1_000
    return f"{hh:02d}{mm:02d}{ss:02d}z"


# ══════════════════════════════════════════════════════════════════════════════
#  cty.dat parser
#  Parses the AD1C Big CTY prefix database (country-files.com/cty/cty.dat).
#  No external libraries required.
# ══════════════════════════════════════════════════════════════════════════════

_OVERRIDE_RE = re.compile(r"[\(\[\{<~][^\)\]\}>~]*[\)\]\}>~]")


def _strip_overrides(token: str) -> tuple:
    """
    Strip CQ/ITU/continent override annotations from a prefix token.
    Returns (clean_token, overrides_dict).

    Annotations in cty.dat:
      (nn)  = CQ zone override
      [nn]  = ITU zone override
      {XX}  = continent override
      <lat/lon>  = lat/lon override (ignored)
      ~nn   = time-zone offset (ignored)
    """
    overrides = {}
    m = re.search(r"\((\d+)\)", token)
    if m:
        overrides["cqz"] = int(m.group(1))
    m = re.search(r"\[(\d+)\]", token)
    if m:
        overrides["ituz"] = int(m.group(1))
    m = re.search(r"\{([A-Z]+)\}", token)
    if m:
        overrides["continent"] = m.group(1)
    clean = _OVERRIDE_RE.sub("", token).strip()
    return clean, overrides


class CtyDat:
    """
    Loads cty.dat and resolves amateur-radio callsigns to DXCC entity info.

    Each entity record in cty.dat looks like:
      Country Name:  CQz: ITUz: Cont: Lat: Long: UTC: Prefix;
          prefix1, prefix2, =EXACT1, =EXACT2, ...;

    We build:
      _exact    : dict  { "CALLSIGN" -> entity_dict }  for exact-match entries
      _prefixes : list  [ ("PREFIX", entity_dict) ]    sorted longest-first
    """

    def __init__(self):
        self._exact:    dict = {}
        self._prefixes: list = []

    # ── Loading ────────────────────────────────────────────────────────────────

    def load(self, path: Path) -> None:
        self._parse(path.read_text(encoding="utf-8", errors="replace"))

    def _parse(self, text: str) -> None:
        # Records start at a non-whitespace character (the country name)
        for record in re.split(r"\n(?=[A-Z*])", text):
            lines = record.strip().splitlines()
            if not lines:
                continue

            # Header line:  Name:CQz:ITUz:Cont:Lat:Lon:UTC:Prefix;
            parts = [p.strip() for p in lines[0].split(":")]
            if len(parts) < 8:
                continue
            try:
                base = {
                    "country":        parts[0].lstrip("*"),
                    "cqz":            int(parts[1]),
                    "ituz":           int(parts[2]),
                    "continent":      parts[3],
                    "latitude":       float(parts[4]),
                    "longitude":      -float(parts[5]),  # cty.dat stores W as +
                    "primary_prefix": parts[7].rstrip(";").strip(),
                }
            except (ValueError, IndexError):
                continue

            # Prefix/callsign lines (comma-separated, terminated by semicolon)
            body = " ".join(lines[1:]).split(";")[0]
            for raw in body.split(","):
                raw = raw.strip()
                if not raw:
                    continue
                exact = raw.startswith("=")
                clean, overrides = _strip_overrides(raw.lstrip("="))
                if not clean:
                    continue
                entry = {**base, **overrides}
                if exact:
                    self._exact[clean.upper()] = entry
                else:
                    self._prefixes.append((clean.upper(), entry))

        # Longest prefix first — greedy match gives best accuracy
        self._prefixes.sort(key=lambda x: len(x[0]), reverse=True)

    # ── Lookup ─────────────────────────────────────────────────────────────────

    def lookup(self, callsign: str) -> dict | None:
        """
        Return entity info dict for *callsign*, or None if not found.
        Handles portable/rover suffixes (W1ABC/P, HC2/DH1TW, VK9/W1ABC, etc.).
        """
        call = callsign.upper().strip()

        # Exact match (handles special callsigns like 3D2/R)
        if call in self._exact:
            return dict(self._exact[call])

        # Slash callsigns
        parts = call.split("/")
        if len(parts) == 2:
            a, b = parts
            portable = {"P", "M", "MM", "AM", "QRP", "QRPP", "A", "B"}
            if b in portable:
                call = a                       # W1ABC/P -> W1ABC
            elif a in portable:
                call = b                       # P/W1ABC -> W1ABC
            elif a and len(a) <= 3 and not a[-1].isdigit():
                # Short non-numeric prefix suggests country: HC2/DH1TW
                r = self._prefix_match(a)
                if r:
                    return r
                call = b
            else:
                # Keep the longer part
                call = a if len(a) >= len(b) else b

        return self._prefix_match(call)

    def _prefix_match(self, call: str) -> dict | None:
        for prefix, entry in self._prefixes:
            if call.startswith(prefix):
                return dict(entry)
        return None


@dataclass
class _CycleSums:
    """Accumulator for one parity slot (even or odd) of WSJT-X decode cycles."""
    total: int = 0   # sum of all decode counts
    cq:    int = 0   # sum of CQ-only decode counts
    count: int = 0   # number of cycles accumulated


class CycleTracker:
    """
    Counts total and CQ decodes per WSJT-X cycle and maintains running averages
    split by even/odd slot parity.

    Parity is determined from time_ms:
      FT8 (15 s cycles): slot = time_ms // 15000; even if slot % 2 == 0
      FT4  (7.5 s cycles): slot = time_ms //  7500; even if slot % 2 == 0
    Only new=True decodes are counted (replayed decodes are ignored).
    A STATS line is returned (not printed) when a cycle boundary is crossed.
    """

    _SLOT_MS = {"FT4": 7500}   # default 15000 ms (FT8 / all others)

    def __init__(self):
        self.current_time_ms: int | None = None
        self._parity: str = "even"
        self.cycle_total: int = 0
        self.cycle_cq:    int = 0
        self._sums: dict = {"even": _CycleSums(), "odd": _CycleSums()}

    @staticmethod
    def _slot_parity(time_ms: int, mode: str) -> str:
        slot_ms = CycleTracker._SLOT_MS.get(mode, 15000)
        return "even" if (time_ms // slot_ms) % 2 == 0 else "odd"

    def _close_cycle(self) -> str:
        """Accumulate the finished cycle and return a formatted STATS line."""
        s = self._sums[self._parity]
        s.total += self.cycle_total
        s.cq    += self.cycle_cq
        s.count += 1

        period = _ms_to_period(self.current_time_ms)

        ev, od = self._sums["even"], self._sums["odd"]
        all_n      = ev.count + od.count
        avg_dec    = (ev.total + od.total) / all_n if all_n else 0.0
        avg_cq     = (ev.cq    + od.cq)   / all_n if all_n else 0.0
        ev_avg_dec = ev.total / ev.count if ev.count else 0.0
        ev_avg_cq  = ev.cq    / ev.count if ev.count else 0.0
        od_avg_dec = od.total / od.count if od.count else 0.0
        od_avg_cq  = od.cq    / od.count if od.count else 0.0

        return (
            f"STATS: {period} [{self._parity}]"
            f"  decodes={self.cycle_total} cq={self.cycle_cq}"
            f"  avg: dec={avg_dec:.1f} cq={avg_cq:.1f}"
            f"  even: dec={ev_avg_dec:.1f} cq={ev_avg_cq:.1f}"
            f"  odd: dec={od_avg_dec:.1f} cq={od_avg_cq:.1f}"
        )

    def record(self, time_ms: int, is_cq: bool, is_new: bool, mode: str) -> str | None:
        """
        Record one decode. Returns a STATS line string when the previous cycle
        just closed, otherwise None. Replayed decodes (is_new=False) are ignored.
        """
        if not is_new:
            return None

        stats_line = None
        if self.current_time_ms is not None and time_ms != self.current_time_ms:
            stats_line = self._close_cycle()
            self.cycle_total = 0
            self.cycle_cq    = 0

        if self.current_time_ms is None or time_ms != self.current_time_ms:
            self.current_time_ms = time_ms
            self._parity = self._slot_parity(time_ms, mode)

        self.cycle_total += 1
        if is_cq:
            self.cycle_cq += 1

        return stats_line


def load_state_set(value: str) -> set:
    """
    Return a set of uppercase US state abbreviations from either a file path
    (one abbreviation per line, # = comment) or a comma-separated list.
    """
    p = Path(value)
    if p.is_file():
        states = set()
        for raw in p.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            states.add(line.upper())
        return states
    return {s.strip().upper() for s in value.split(",") if s.strip()}


class HamdatLookup:
    """
    Read-only interface to a hamdat SQLite database for callsign → US state lookups.
    Results are cached in memory so repeated decodes of the same callsign hit the
    DB only once per run.
    """

    def __init__(self, db_path: Path):
        self.db_path = db_path
        self._conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        self._cache: dict = {}

    def state(self, callsign: str) -> str | None:
        """Return the 2-letter US state code for an active license, or None."""
        call = callsign.upper().strip()
        if call in self._cache:
            return self._cache[call]
        row = self._conn.execute(
            """SELECT e.state
               FROM license_header h
               JOIN entity e ON e.unique_system_identifier = h.unique_system_identifier
                   AND (e.entity_type = 'L' OR e.entity_type = '')
               WHERE h.call_sign = ? AND h.license_status = 'A'
               ORDER BY h.id DESC LIMIT 1""",
            (call,),
        ).fetchone()
        result = (row[0] or "").strip().upper() or None if row else None
        self._cache[call] = result
        return result

    def close(self):
        self._conn.close()


def load_regex_patterns(file_paths: list) -> list:
    """Load compiled regex patterns from one or more files, one pattern per line.
    Blank lines and lines starting with '#' are ignored.
    Returns a list of (compiled_pattern, source_filename) tuples."""
    patterns = []
    for path_str in file_paths:
        p = Path(path_str)
        try:
            for i, raw in enumerate(p.read_text(encoding="utf-8").splitlines(), 1):
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                try:
                    patterns.append((re.compile(line, re.IGNORECASE), p.name))
                except re.error as exc:
                    print(f"[match] {p.name}:{i}: invalid regex {line!r}: {exc}",
                          file=sys.stderr)
        except OSError as exc:
            print(f"[match] Cannot read {p}: {exc}", file=sys.stderr)
            sys.exit(1)
    return patterns


def _regex_matches(value: str, patterns: list) -> list:
    """Return match label strings for each (compiled_pattern, source) that matches *value*.
    Label format: 'pattern [source]' when source is set, else just 'pattern'."""
    results = []
    for pat, src in patterns:
        if pat.search(value):
            results.append(f"{pat.pattern} [{src}]" if src else pat.pattern)
    return results


def _build_alert_msg(callsign, entity_info: dict,
                     needed_flags: list, match_flags: list) -> str:
    """Build a compact one-line summary for external alert delivery."""
    segments = [callsign or "?"]
    if entity_info:
        segments.append(f"{entity_info['entity']} CQ{entity_info['cq_zone']}")
    flag_parts = []
    if needed_flags:
        flag_parts.append("NEEDED: " + ", ".join(needed_flags))
    if match_flags:
        flag_parts.append("MATCH: " + ", ".join(match_flags))
    if flag_parts:
        segments.append("  ".join(flag_parts))
    return " | ".join(segments)


def _send_alerts(msg: str, args: argparse.Namespace) -> None:
    """Dispatch an alert message via --alert-command and/or --alert-ntfy."""
    if args.alert_command:
        try:
            subprocess.Popen([args.alert_command, msg])
        except Exception as exc:
            print(f"[alert-command] {exc}", file=sys.stderr)

    if args.alert_ntfy:
        try:
            req = urllib.request.Request(
                f"https://ntfy.sh/{args.alert_ntfy}",
                data=msg.encode("utf-8"),
                method="POST",
            )
            req.add_header("Title", "jtwatch")
            urllib.request.urlopen(req, timeout=10)
        except Exception as exc:
            print(f"[alert-ntfy] {exc}", file=sys.stderr)


def _encode_utf8(s: str) -> bytes:
    """Encode a string as a Qt QDataStream QString (big-endian length + UTF-8 bytes)."""
    if not s:
        return struct.pack(">I", 0xFFFFFFFF)
    b = s.encode("utf-8")
    return struct.pack(">I", len(b)) + b


def _send_reply(tx_sock, wsjt_addr: tuple, decoded: dict) -> None:
    """
    Send a WSJT-X Reply (Type 4) message to wsjt_addr.

    This is the protocol equivalent of double-clicking a decode in the WSJT-X
    UI: WSJT-X will set the DX callsign, generate the appropriate response
    message, and enable TX.

    Requires "Accept UDP requests" to be checked in WSJT-X
    Settings → Reporting.
    """
    buf = bytearray()
    buf += struct.pack(">III", MAGIC, 2, MSG_REPLY)   # magic, schema=2, type=Reply
    buf += _encode_utf8(decoded["id"])
    buf += struct.pack(">I",  decoded["time_ms"])
    buf += struct.pack(">i",  decoded["snr"])
    buf += struct.pack(">d",  decoded["dt"])
    buf += struct.pack(">I",  decoded["df"])
    buf += _encode_utf8(decoded["mode"])
    buf += _encode_utf8(decoded["message"])
    buf += struct.pack(">B",  1 if decoded.get("low_conf") else 0)
    buf += struct.pack(">B",  0)                      # Modifiers: none
    try:
        tx_sock.sendto(bytes(buf), wsjt_addr)
    except OSError as exc:
        print(f"[call] Reply send failed: {exc}", file=sys.stderr)


def _prompt_call(callsign: str, timeout: float) -> bool:
    """
    Write "Do you want to call <callsign>? [Y/n] " to stderr and wait up to
    *timeout* seconds for a keystroke.  Returns True on yes/Enter, False on
    no or timeout.  Silently returns False when stdin is not a TTY.
    """
    if not sys.stdin.isatty():
        return False

    sys.stderr.write(f"\nDo you want to call {callsign}? [Y/n] ")
    sys.stderr.flush()

    try:
        ready, _, _ = select.select([sys.stdin], [], [], timeout)
    except OSError:
        sys.stderr.write("\n")
        sys.stderr.flush()
        return False

    if ready:
        answer = sys.stdin.readline().strip().lower()
        return answer in ("", "y", "yes")

    sys.stderr.write("(timeout — no)\n")
    sys.stderr.flush()
    return False


def download_cty(path: Path) -> None:
    """Download cty.dat from country-files.com and save to *path*."""
    print(f"[cty.dat] Downloading from {CTY_DAT_URL} …", file=sys.stderr)
    req = urllib.request.Request(
        CTY_DAT_URL, headers={"User-Agent": "jtwatch/1.0"}
    )
    with urllib.request.urlopen(req, timeout=20) as resp:
        path.write_bytes(resp.read())
    print(f"[cty.dat] Saved to {path}", file=sys.stderr)


# ══════════════════════════════════════════════════════════════════════════════
#  ADIF parser + worked-log tracker
# ══════════════════════════════════════════════════════════════════════════════

_ADIF_FIELD_RE = re.compile(
    r"<([A-Za-z_][A-Za-z0-9_]*)(?::[^:>]*)?:(\d+)(?::[A-Za-z])?>",
    re.IGNORECASE,
)
_ADIF_EOH_RE = re.compile(r"<EOH>", re.IGNORECASE)
_ADIF_EOR_RE = re.compile(r"<EOR>", re.IGNORECASE)


def parse_adif(path: Path) -> list:
    """
    Parse an ADIF file and return a list of QSO dicts.
    Keys are lower-cased ADIF field names; values are stripped strings.
    Handles both ADIF 2 and ADIF 3 files, with or without a header.
    """
    text = path.read_text(encoding="utf-8", errors="replace")

    # Skip everything before the first <EOH>
    eoh  = _ADIF_EOH_RE.search(text)
    body = text[eoh.end():] if eoh else text

    qsos: list = []
    pos = 0
    current: dict = {}

    while pos < len(body):
        m   = _ADIF_FIELD_RE.search(body, pos)
        eor = _ADIF_EOR_RE.search(body, pos)

        # <EOR> closes the current record
        if eor and (not m or eor.start() < m.start()):
            if current:
                qsos.append(current)
                current = {}
            pos = eor.end()
            continue

        if not m:
            break

        field  = m.group(1).lower()
        flen   = int(m.group(2))
        vstart = m.end()
        current[field] = body[vstart : vstart + flen].strip()
        pos = vstart + flen

    if current:
        qsos.append(current)

    return qsos


class AdifLog:
    """
    Parses an ADIF file and builds three sets of what has already been worked:

      worked_dxcc    — primary prefixes  e.g. {"W", "DL", "VK", "JA"}
      worked_cqz     — CQ zone ints      e.g. {5, 14, 28, 29}
      worked_country — upper-cased country names  e.g. {"UNITED STATES", "GERMANY"}

    Sets are populated from explicit ADIF fields first; if a field is absent
    the callsign is resolved via cty.dat to fill in the blanks.

    The needed_flags() method checks an incoming entity_info dict against these
    sets and returns a list of human-readable NEEDED reason strings.
    """

    def __init__(self, paths, cty: CtyDat, hamdat=None, qsl_only: bool = False):
        self.paths     = [paths] if isinstance(paths, Path) else list(paths)
        self.cty       = cty
        self._hamdat   = hamdat
        self._qsl_only = qsl_only

        self.worked_calls:        set  = set()
        self.worked_grids:        set  = set()
        self.worked_states:       set  = set()
        self.worked_dxcc:         set  = set()   # filtered by qsl_only when active
        self.worked_cqz:          set  = set()   # filtered by qsl_only when active
        self.worked_country:      set  = set()   # filtered by qsl_only when active
        self.worked_dxcc_all:     set  = set()   # all QSOs regardless of QSL status
        self.worked_cqz_all:      set  = set()   # all QSOs regardless of QSL status
        self.worked_country_all:  set  = set()   # all QSOs regardless of QSL status
        self.qrz_confirmed_calls: set  = set()   # callsigns with app_qrzlog_status=C
        self.lotw_qsl_rcvd_calls: set  = set()   # callsigns with lotw_qsl_rcvd=Y
        self.last_worked:         dict = {}       # call -> most recent date worked
        self.total_qsos = 0

        self._load()

    def _load(self) -> None:
        qsos = []
        for path in self.paths:
            qsos.extend(parse_adif(path))
        self.total_qsos = len(qsos)

        for q in qsos:
            call    = q.get("call", "").strip().upper()
            cqz_raw = (q.get("cqz") or q.get("cq_zone") or "").strip()
            country = (q.get("country") or q.get("entity") or "").strip().upper()
            # Truncate to 4 chars — FT8 transmits 4-char grids; 6-char ADIF values match too
            grid    = q.get("gridsquare", "").strip().upper()[:4]

            # QSL receipt status
            qrz_status = q.get("app_qrzlog_status", "").strip().upper()
            lotw_rcvd  = q.get("lotw_qsl_rcvd",    "").strip().upper()
            if call and qrz_status == "C":
                self.qrz_confirmed_calls.add(call)
            if call and lotw_rcvd == "Y":
                self.lotw_qsl_rcvd_calls.add(call)

            # Track most-recent QSO date per callsign (regardless of QSL status)
            qso_date_str = q.get("qso_date", "").strip()
            if call and len(qso_date_str) == 8:
                try:
                    qso_date = datetime.strptime(qso_date_str, "%Y%m%d").date()
                    existing = self.last_worked.get(call)
                    if existing is None or qso_date > existing:
                        self.last_worked[call] = qso_date
                except ValueError:
                    pass

            # In --qsl-only mode, only LoTW-confirmed QSOs count toward worked DXCC/zone/country
            counts_as_worked = (not self._qsl_only) or (lotw_rcvd == "Y")

            # Populate from explicit ADIF fields
            try:
                cqz_int = int(cqz_raw)
                self.worked_cqz_all.add(cqz_int)
                if counts_as_worked:
                    self.worked_cqz.add(cqz_int)
            except ValueError:
                pass

            if country:
                self.worked_country_all.add(country)
                if counts_as_worked:
                    self.worked_country.add(country)

            if grid:
                self.worked_grids.add(grid)

            # Fill missing fields via cty.dat lookup on the callsign
            if call:
                self.worked_calls.add(call)
                info = self.cty.lookup(call)
                if info:
                    self.worked_dxcc_all.add(info["primary_prefix"].upper())
                    if counts_as_worked:
                        self.worked_dxcc.add(info["primary_prefix"].upper())
                    if not cqz_raw:
                        self.worked_cqz_all.add(info["cqz"])
                        if counts_as_worked:
                            self.worked_cqz.add(info["cqz"])
                    # Always add cty.dat country name so it stays consistent with
                    # the decode-time check in needed_flags() / worked_flags(),
                    # which also use cty.dat.  If the ADIF country field has a
                    # different string (e.g. "Portugal" vs "Madeira Islands"), the
                    # ADIF-only path above would leave worked_country with a name
                    # that never matches, causing false NEEDED alerts / ❓ icons
                    # even when the entity is fully confirmed.
                    self.worked_country_all.add(info["country"].upper())
                    if counts_as_worked:
                        self.worked_country.add(info["country"].upper())

        if self._hamdat:
            for call in self.worked_calls:
                state = self._hamdat.state(call)
                if state:
                    self.worked_states.add(state)

        names = ", ".join(p.name for p in self.paths)
        lines = [
            f"[adif] Loaded {self.total_qsos} QSOs from {names}",
            f"[adif]   {len(self.worked_calls)} unique callsigns worked",
            f"[adif]   {len(self.worked_grids)} grid squares worked",
        ]
        if self._hamdat:
            lines.append(f"[adif]   {len(self.worked_states)} states worked")
        lines += [
            f"[adif]   {len(self.worked_dxcc)} DXCC entities worked",
            f"[adif]   {len(self.worked_cqz)} CQ zones worked",
            f"[adif]   {len(self.worked_country)} countries worked",
            f"[adif]   {len(self.qrz_confirmed_calls)} callsigns QRZ confirmed (app_qrzlog_status=C)",
            f"[adif]   {len(self.lotw_qsl_rcvd_calls)} callsigns with LoTW confirmed (lotw_qsl_rcvd=Y)",
        ]
        if self._qsl_only:
            lines.append(
                f"[adif]   qsl-only: {len(self.worked_dxcc)} of "
                f"{len(self.worked_dxcc_all)} DXCC entities have LoTW confirmation"
            )
        print("\n".join(lines), file=sys.stderr)

    @staticmethod
    def _entity_keys(entity_info: dict) -> tuple:
        """Extract (prefix, cqz, country) lookup keys from an entity_info dict."""
        return (
            (entity_info.get("primary_prefix") or "").upper(),
            entity_info.get("cq_zone"),                          # int or "?"
            (entity_info.get("entity") or "").upper(),
        )

    def needed_flags(self, entity_info: dict, args: argparse.Namespace) -> list:
        """
        Return a list of NEEDED reason strings for *entity_info*.
        Empty list = everything already worked, or checks disabled.

        Possible entries:
          "NEW-DXCC(prefix)"    primary prefix not in worked_dxcc
          "NEW-CQZ(n)"          CQ zone not in worked_cqz
          "NEW-CTRY(name)"      country not in worked_country
        """
        prefix, cqz, country = self._entity_keys(entity_info)
        flags = []
        if args.need_entity and prefix and prefix not in self.worked_dxcc:
            flags.append(f"NEW-DXCC({prefix})")
        if args.need_cqz and isinstance(cqz, int) and cqz not in self.worked_cqz:
            flags.append(f"NEW-CQZ({cqz})")
        if args.need_country and country and country not in self.worked_country:
            flags.append(f"NEW-CTRY({entity_info.get('entity', '?')})")
        return flags

    def worked_flags(self, entity_info: dict, args: argparse.Namespace) -> list:
        """Return which enabled categories in entity_info are already worked (qsl-filtered)."""
        prefix, cqz, country = self._entity_keys(entity_info)
        flags = []
        if args.need_entity and prefix and prefix in self.worked_dxcc:
            flags.append("dxcc")
        if args.need_cqz and isinstance(cqz, int) and cqz in self.worked_cqz:
            flags.append("cqz")
        if args.need_country and country and country in self.worked_country:
            flags.append("country")
        return flags

    def worked_flags_all(self, entity_info: dict, args: argparse.Namespace) -> list:
        """Return which enabled categories were worked in any QSO (ignores qsl_only filter)."""
        prefix, cqz, country = self._entity_keys(entity_info)
        flags = []
        if args.need_entity and prefix and prefix in self.worked_dxcc_all:
            flags.append("dxcc")
        if args.need_cqz and isinstance(cqz, int) and cqz in self.worked_cqz_all:
            flags.append("cqz")
        if args.need_country and country and country in self.worked_country_all:
            flags.append("country")
        return flags


# ══════════════════════════════════════════════════════════════════════════════
#  CQ message parser
# ══════════════════════════════════════════════════════════════════════════════

_GRID_RE = re.compile(r"\b([A-R]{2}\d{2}(?:[A-X]{2})?)\b", re.IGNORECASE)


def _make_entity_info(raw: dict) -> dict:
    """
    Build an entity_info dict from a raw cty.dat lookup result.
    Renames cty.dat keys (country, cqz, ituz) to the display-layer names
    (entity, cq_zone, itu_zone) used throughout the rest of the program.
    """
    return {
        "primary_prefix": raw.get("primary_prefix", "?"),
        "entity":         raw.get("country",        "?"),
        "cq_zone":        raw.get("cqz",            "?"),
        "itu_zone":       raw.get("ituz",            "?"),
        "continent":      raw.get("continent",       "?"),
    }


# CQ [MODIFIER] CALLSIGN [GRID]
# MODIFIER is 1-13 alpha chars: DX, POTA, SOTA, JA, NA, contest names, etc.
# CALLSIGN must contain at least one digit — a universal property of amateur callsigns.
# This lets the regex distinguish geo/contest qualifiers (all-alpha) from callsigns
# without a static list, so "CQ JA W1ABC" correctly identifies W1ABC, not JA.
_CQ_RE = re.compile(
    r"^CQ\s+"
    r"(?:(?P<modifier>[A-Z]{1,13})\s+)?"
    r"(?P<callsign>(?=[A-Z0-9/]*\d)[A-Z0-9/]{3,})"
    r"(?:\s+(?P<grid>[A-R]{2}\d{2}(?:[A-X]{2})?))?\s*$",
    re.IGNORECASE,
)


def parse_cq_message(msg: str) -> tuple:
    """
    Parse a WSJT-X CQ message string.
    Returns (callsign, gridsquare, modifier) — any element may be None.

    Examples:
      "CQ W1ABC FN42"       -> ("W1ABC", "FN42", None)
      "CQ DX K7XYZ DM41"   -> ("K7XYZ", "DM41", "DX")
      "CQ POTA N3ZZZ EN91" -> ("N3ZZZ", "EN91", "POTA")
      "CQ JA W1ABC FN42"   -> ("W1ABC", "FN42", "JA")
      "CQ W1ABC"            -> ("W1ABC", None, None)
    """
    msg = msg.strip()
    if not msg.upper().startswith("CQ"):
        return None, None, None

    m = _CQ_RE.match(msg)
    if not m:
        return None, None, None

    modifier = (m.group("modifier") or "").upper()
    callsign = (m.group("callsign") or "").upper()
    grid     = (m.group("grid")     or "").upper() or None

    return callsign or None, grid, modifier or None


# ══════════════════════════════════════════════════════════════════════════════
#  Qt binary stream reader  (WSJT-X uses Qt's QDataStream, big-endian)
# ══════════════════════════════════════════════════════════════════════════════

class Reader:
    def __init__(self, data: bytes):
        self.data = data
        self.pos  = 0

    def _read(self, n: int) -> bytes:
        if self.pos + n > len(self.data):
            raise ValueError("Packet underflow")
        chunk = self.data[self.pos : self.pos + n]
        self.pos += n
        return chunk

    def u8(self)    -> int:   return struct.unpack(">B", self._read(1))[0]
    def u32(self)   -> int:   return struct.unpack(">I", self._read(4))[0]
    def i32(self)   -> int:   return struct.unpack(">i", self._read(4))[0]
    def f32(self)   -> float: return struct.unpack(">f", self._read(4))[0]
    def f64(self)   -> float: return struct.unpack(">d", self._read(8))[0]
    def bool_(self) -> bool:  return self.u8() != 0

    def utf8(self) -> str:
        """Qt QString: 4-byte length (0xFFFFFFFF = null/empty), then UTF-8 bytes."""
        n = self.u32()
        if n == 0xFFFFFFFF:
            return ""
        return self._read(n).decode("utf-8", errors="replace")


def parse_decode_msg(r: Reader) -> dict:
    """Parse a WSJT-X Decode message (type 2) from a Reader."""
    d = {
        "id":       r.utf8(),
        "new":      r.bool_(),
        "time_ms":  r.u32(),
        "snr":      r.i32(),
        "dt":       r.f64(),
        "df":       r.u32(),
        "mode":     r.utf8(),
        "message":  r.utf8(),
        "low_conf": r.bool_(),
    }
    try:
        d["off_air"] = r.bool_()   # schema version ≥ 3 only
    except ValueError:
        d["off_air"] = False
    return d


def _parse_packet(data: bytes) -> dict | None:
    """
    Validate and decode one raw WSJT-X UDP datagram.
    Returns the decoded-fields dict (with an extra '_schema' key) or None if
    the packet is too short, has the wrong magic, or is not a Decode message.
    """
    if len(data) < 12:
        return None
    r = Reader(data)
    try:
        if r.u32() != MAGIC:
            return None
        schema = r.u32()
        if r.u32() != MSG_DECODE:
            return None
        d = parse_decode_msg(r)
    except (ValueError, struct.error):
        return None
    d["_schema"] = schema
    return d


# ══════════════════════════════════════════════════════════════════════════════
#  Session state + packet handler
# ══════════════════════════════════════════════════════════════════════════════

@dataclass
class Session:
    """
    Holds all stable per-run state. adif_log is mutable — main() updates it
    when the ADIF file changes on disk. alerted and prompted are auto-initialized.
    """
    args:          argparse.Namespace
    cty:           CtyDat
    adif_log:      AdifLog | None
    json_fh:       object                  # text file | None
    call_patterns: list
    msg_patterns:  list
    state_set:     set
    hamdat:        HamdatLookup | None
    cycle_tracker: CycleTracker | None
    tx_sock:       socket.socket
    alerted:       set = field(default_factory=set)   # (call, frozenset(flags)) dedup
    prompted:      set = field(default_factory=set)   # calls already shown --call prompt

    # ── Public entry point ────────────────────────────────────────────────────

    def handle_packet(self, data: bytes, wsjt_addr: tuple) -> bool:
        """
        Decode one UDP datagram. If it is a CQ (or --raw is set):
          • print a formatted line to stdout
          • append a JSON record to json_fh if --save was given
        Returns True if a line was printed.
        """
        decoded = _parse_packet(data)
        if decoded is None:
            return False

        if self.args.debug:
            self._debug(decoded, data)

        msg_text = decoded["message"].strip()
        is_cq    = msg_text.upper().startswith("CQ")
        mode     = _MODE_NAMES.get(decoded["mode"], decoded["mode"]) or "?"

        if self.cycle_tracker is not None:
            stats = self.cycle_tracker.record(decoded["time_ms"], is_cq, decoded["new"], mode)
            if stats:
                print(stats, flush=True)

        if not is_cq and not self.args.raw:
            return False

        callsign, grid, modifier, entity_info = self._resolve_cq(msg_text, is_cq)
        needed_flags, match_flags, station_state = self._check_flags(
            callsign, entity_info, msg_text, is_cq
        )

        if (needed_flags or match_flags) and (self.args.alert_command or self.args.alert_ntfy):
            key = (callsign, frozenset(needed_flags + match_flags))
            if key not in self.alerted:
                self.alerted.add(key)
                _send_alerts(
                    _build_alert_msg(callsign, entity_info, needed_flags, match_flags),
                    self.args,
                )

        self._print_line(decoded, msg_text, is_cq, mode,
                         callsign, grid, entity_info, station_state,
                         needed_flags, match_flags)

        # Bell is tied to the prompt: sounds once per callsign, only with --call.
        if (needed_flags or match_flags) and self.args.call and callsign and callsign not in self.prompted:
            self.prompted.add(callsign)
            print(BELL, end="", flush=True)
            if _prompt_call(callsign, self.args.call_timeout):
                sys.stderr.write(f"[call] Sending reply to {callsign} and enabling TX\n")
                sys.stderr.flush()
                _send_reply(self.tx_sock, wsjt_addr, decoded)

        if self.json_fh and is_cq:
            self._write_json(decoded, msg_text, mode, callsign, grid, modifier,
                             entity_info, needed_flags)
        return True

    # ── Private helpers ───────────────────────────────────────────────────────

    def _within_lag(self, callsign: str | None) -> bool:
        """True if callsign was worked within --worked-lag-days days."""
        return (
            callsign is not None
            and self.adif_log is not None
            and self.args.worked_lag_days >= 0
            and callsign in self.adif_log.last_worked
            and (datetime.now(timezone.utc).date() - self.adif_log.last_worked[callsign]).days
                <= self.args.worked_lag_days
        )

    def _resolve_cq(self, msg_text: str, is_cq: bool) -> tuple:
        """Parse CQ fields and resolve the callsign to entity info via cty.dat."""
        callsign = grid = modifier = None
        entity_info: dict = {}
        if not is_cq:
            return callsign, grid, modifier, entity_info

        callsign, grid, modifier = parse_cq_message(msg_text)
        if not grid:
            gm = _GRID_RE.search(msg_text)
            if gm:
                grid = gm.group(1).upper()

        if callsign:
            raw = self.cty.lookup(callsign)
            if raw:
                entity_info = _make_entity_info(raw)
        return callsign, grid, modifier, entity_info

    def _check_flags(self, callsign, entity_info, msg_text, is_cq) -> tuple:
        """
        Compute needed_flags, match_flags, and station_state for one decode.
        Applies --worked-lag-days suppression to both flag lists.
        """
        needed_flags: list = []
        if self.adif_log and is_cq and entity_info:
            needed_flags = self.adif_log.needed_flags(entity_info, self.args)
        if needed_flags and self._within_lag(callsign):
            needed_flags = []

        match_flags: list = []
        if self.call_patterns and callsign:
            match_flags.extend(f"CALL:{m}" for m in _regex_matches(callsign, self.call_patterns))
        if self.msg_patterns and msg_text:
            match_flags.extend(f"MSG:{m}" for m in _regex_matches(msg_text, self.msg_patterns))

        station_state: str | None = None
        if self.hamdat and callsign:
            station_state = self.hamdat.state(callsign)
            if self.state_set and station_state and station_state in self.state_set:
                match_flags.append(f"STATE:{station_state}")

        if match_flags and self._within_lag(callsign):
            match_flags = []

        return needed_flags, match_flags, station_state

    def _print_line(self, decoded, msg_text, is_cq, mode,
                    callsign, grid, entity_info, station_state,
                    needed_flags, match_flags) -> None:
        """Build and print the fixed-width output line plus any alert sub-line."""
        args     = self.args
        adif_log = self.adif_log
        color    = args.color

        cols: list = []
        if args.show_time:
            cols.append(_col(f"[{datetime.now().strftime('%H:%M:%S')}]", _DIM, color))

        cols.append(_col(_ms_to_period(decoded["time_ms"]),  _DIM, color))
        cols.append(_col(f"{decoded['snr']:+4d}",            _DIM, color))
        cols.append(_col(f"{decoded['dt']:+6.1f}s",          _DIM, color))
        cols.append(_col(f"{decoded['df']:5d}",              _DIM, color))
        cols.append(_col(f"{mode:<4}",                       _DIM, color))
        cols.append(f"{msg_text:<{_W_MSG}}")

        # Callsign and grid are always emitted (blank when absent) so the
        # entity column stays at a consistent horizontal position on every line.
        call_col    = callsign if (is_cq and callsign) else ""
        call_worked = bool(adif_log and call_col and call_col in adif_log.worked_calls)
        if call_col:
            cols.append(_col(f"{call_col:<{_W_CALL}}", _BGRN if call_worked else _BOLD, color))
        else:
            cols.append(f"{call_col:<{_W_CALL}}")

        grid_col    = grid or ""
        grid_worked = bool(adif_log and grid_col and grid_col[:4] in adif_log.worked_grids)
        cols.append(_col(f"{grid_col:<{_W_GRID}}", _GRN, color) if (grid_worked and grid_col)
                    else f"{grid_col:<{_W_GRID}}")

        if adif_log:
            days_str = " " * _W_DAYS
            if call_col and call_col in adif_log.last_worked:
                delta = (datetime.now(timezone.utc).date() - adif_log.last_worked[call_col]).days
                days_str = f"{delta:>4d}d"
            cols.append(days_str)

        if self.hamdat and is_cq:
            st_val    = station_state or ""
            st_worked = bool(adif_log and st_val and st_val in adif_log.worked_states)
            cols.append(_col(f"{st_val:<2}", _GRN, color) if st_worked else f"{st_val:<2}")

        if entity_info:
            em1 = em2 = em3 = ""
            if adif_log and is_cq:
                wf     = set(adif_log.worked_flags(entity_info, args))
                wf_all = set(adif_log.worked_flags_all(entity_info, args))
                if args.need_entity:
                    em1 = "✅" if "dxcc"    in wf else ("❓" if "dxcc"    in wf_all else "❌")
                if args.need_cqz:
                    em2 = "✅" if "cqz"     in wf else ("❓" if "cqz"     in wf_all else "❌")
                if args.need_country:
                    em3 = "✅" if "country" in wf else ("❓" if "country" in wf_all else "❌")
            entity_str = (
                f"| {entity_info['entity']:<30}"
                f"  {em1}CQ{entity_info['cq_zone']:<3}"
                f" {em2}ITU{entity_info['itu_zone']:<3}"
                f" {em3}{entity_info['continent']:<2}"
            )
            cols.append(_col(entity_str, _CYN, color))

        if adif_log:
            cols.append("⭐" if (call_col and call_col in adif_log.qrz_confirmed_calls) else "  ")
            cols.append("🌎" if (call_col and call_col in adif_log.lotw_qsl_rcvd_calls) else "  ")

        print("  ".join(cols), flush=True)

        alert_parts: list = []
        if adif_log and is_cq and needed_flags:
            alert_parts.append(_col(f"*** NEEDED: {', '.join(needed_flags)} ***", _BRED, color))
        if match_flags:
            alert_parts.append(_col(f"*** MATCH: {', '.join(match_flags)} ***", _BYEL, color))
        if alert_parts:
            print("  " + "  ".join(alert_parts), flush=True)

    def _write_json(self, decoded, msg_text, mode, callsign, grid, modifier,
                    entity_info, needed_flags) -> None:
        """Append a JSON-lines record to the --save file."""
        record = {
            "wall_utc":       datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "period_utc":     _ms_to_period(decoded["time_ms"]),
            "snr_db":         decoded["snr"],
            "dt_s":           round(decoded["dt"], 2),
            "df_hz":          decoded["df"],
            "mode":           mode,
            "message":        msg_text,
            "callsign":       callsign,
            "modifier":       modifier or None,
            "gridsquare":     grid or None,
            "primary_prefix": entity_info.get("primary_prefix"),
            "entity":         entity_info.get("entity"),
            "cq_zone":        entity_info.get("cq_zone"),
            "itu_zone":       entity_info.get("itu_zone"),
            "continent":      entity_info.get("continent"),
            "needed":         needed_flags if self.adif_log else None,
        }
        self.json_fh.write(json.dumps(record) + "\n")
        self.json_fh.flush()

    def _debug(self, decoded: dict, data: bytes) -> None:
        """Dump raw hex and parsed fields of a Decode packet to stderr."""
        print(
            f"[debug] schema={decoded['_schema']}  len={len(data)}\n"
            f"[debug] hex: {data.hex()}\n"
            f"[debug] id={decoded['id']!r}  new={decoded['new']}  "
            f"time_ms={decoded['time_ms']}  snr={decoded['snr']}\n"
            f"[debug] dt={decoded['dt']:.3f}  df={decoded['df']}  "
            f"mode={decoded['mode']!r}  message={decoded['message']!r}\n"
            f"[debug] low_conf={decoded['low_conf']}  off_air={decoded['off_air']}",
            file=sys.stderr,
        )


# ══════════════════════════════════════════════════════════════════════════════
#  Entry point
# ══════════════════════════════════════════════════════════════════════════════

_HEADER_EVERY = 15


def _print_header(args: argparse.Namespace, has_adif: bool = False) -> None:
    """Print the column header and separator to stdout, matching actual data widths."""
    parts = []
    if args.show_time:
        parts.append(f"{'[time]':<10}")       # "[HH:MM:SS]" = 10 chars
    parts.append(f"{'HHMMSSZ':<7}")            # period_utc      = 7 chars
    parts.append(f"{'dB':>4}")                 # f"{snr:+4d}"    = 4 chars
    parts.append(f"{'dt(s)':>7}")              # f"{dt:+6.1f}s"  = 7 chars
    parts.append(f"{'Hz':>5}")                 # f"{df:5d}"      = 5 chars
    parts.append(f"{'mode':<4}")               # f"{mode:<4}"    = 4 chars
    parts.append(f"{'message':<{_W_MSG}}")
    parts.append(f"{'callsign':<{_W_CALL}}")
    parts.append(f"{'grid':<{_W_GRID}}")
    if has_adif:
        parts.append(f"{'days':>{_W_DAYS}}")
    if args.match_state:
        parts.append(f"{'ST':<2}")
    # entity block; when --adif active each of CQz/ITUz/ct is prefixed by a 2-cell emoji
    w = 2 if has_adif and args.need_entity  else 0
    x = 2 if has_adif and args.need_cqz     else 0
    y = 2 if has_adif and args.need_country  else 0
    parts.append(f"| {'entity':<30}  {'':{w}}CQz   {'':{x}}ITUz   {'':{y}}ct")
    if has_adif:
        parts.append("QRZ")
        parts.append("LoW")
    print("  ".join(parts), flush=True)
    print("-" * 140, flush=True)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=(
            "Monitor WSJT-X CQ calls via UDP.\n"
            "Enriches output with DXCC entity / CQ zone / country / grid.\n"
            "With --adif, flags and bells NEEDED contacts not yet in your log."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
examples:
  jtwatch
  jtwatch --adif ~/Documents/wsjtx_log.adi
  jtwatch --adif ~/wsjtx_log.adi --save cq.jsonl
  jtwatch --adif ~/wsjtx_log.adi --no-need-cqz --no-need-country
  jtwatch --raw --show-time --port 2237
  jtwatch --match-calls watchlist.txt
  jtwatch --match-calls rare_dx.txt pota.txt --match-message sota.txt
        """,
    )

    # Network
    parser.add_argument("--host", default="0.0.0.0",
                        help="UDP bind address (default: 0.0.0.0)")
    parser.add_argument("--port", type=int, default=2237,
                        help="UDP port matching WSJT-X Settings → Reporting (default: 2237)")
    parser.add_argument(
        "--proxy", metavar="PORT[,PORT...]",
        help=(
            "Forward every received WSJT-X packet to these additional UDP ports on localhost. "
            "Lets other tools (e.g. GridTracker) share the same WSJT-X data stream without "
            "competing for port 2237. Example: --proxy 2238 or --proxy 2238,2239"
        ),
    )

    # Display
    parser.add_argument("--show-time", action="store_true",
                        help="Prepend local wall-clock HH:MM:SS to each line")
    parser.add_argument("--raw", action="store_true",
                        help="Print ALL decoded messages, not just CQ")

    # Output file
    parser.add_argument("--save", metavar="FILE",
                        help="Append each CQ record as a JSON line to FILE")

    # Data files
    parser.add_argument(
        "--cty", metavar="PATH", default=str(CTY_DAT_DEFAULT),
        help=(
            f"Path to cty.dat (default: {CTY_DAT_DEFAULT}). "
            "Downloaded automatically from country-files.com on first run."
        ),
    )
    parser.add_argument(
        "--adif", metavar="FILE", nargs="+",
        help=(
            "ADIF log file(s) to compare against for NEEDED detection. "
            "Multiple files are merged into a single worked log. "
            "Contacts whose DXCC entity, CQ zone, or country are NOT in the "
            "log are flagged *** NEEDED ***."
        ),
    )

    # NEEDED toggles — all on by default when --adif is provided
    parser.add_argument("--no-need-entity",  dest="need_entity",
                        action="store_false", default=True,
                        help="Disable NEEDED check for DXCC entity / primary prefix")
    parser.add_argument("--no-need-cqz",     dest="need_cqz",
                        action="store_false", default=True,
                        help="Disable NEEDED check for CQ zone number")
    parser.add_argument("--no-need-country", dest="need_country",
                        action="store_false", default=True,
                        help="Disable NEEDED check for country name")
    parser.add_argument(
        "--qsl-only", action="store_true", dest="qsl_only",
        help=(
            "Require LoTW confirmation for NEEDED detection: QSOs with "
            "lotw_qsl_rcvd≠Y are treated as still needed for DXCC entity, "
            "CQ zone, and country checks. Worked callsign/grid coloring is "
            "unaffected (shows all contacts regardless of QSL status)."
        ),
    )
    parser.add_argument(
        "--worked-lag-days", metavar="DAYS", type=int, default=0,
        dest="worked_lag_days",
        help="Suppress NEEDED alerts for a callsign already worked within this many days "
             "(default: 0, meaning worked today is suppressed). Set to -1 to disable "
             "the suppression entirely.",
    )

    # Pattern matching
    parser.add_argument(
        "--match-calls", metavar="FILE", nargs="+",
        help="File(s) containing callsign regex patterns (one per line, # = comment). "
             "Matching CQs are flagged *** MATCH *** and ring the bell.",
    )
    parser.add_argument(
        "--match-message", metavar="FILE", nargs="+",
        help="File(s) containing full decoded-message regex patterns (one per line, # = comment). "
             "Matching messages are flagged *** MATCH *** and ring the bell.",
    )
    parser.add_argument("--pota", action="store_true",
                        help="Flag CQ POTA calls as *** MATCH *** (no file required).")
    parser.add_argument("--sota", action="store_true",
                        help="Flag CQ SOTA calls as *** MATCH *** (no file required).")
    parser.add_argument("--iota", action="store_true",
                        help="Flag CQ IOTA calls as *** MATCH *** (no file required).")
    parser.add_argument(
        "--match-state", metavar="STATES",
        help=(
            "Comma-separated US state abbreviations (e.g. TX,CA,NY) or a file with one "
            "abbreviation per line (# = comment). Callsigns are resolved to their FCC-licensed "
            "state via the hamdat SQLite database. Matching CQs are flagged *** MATCH *** and "
            "a ST column is added to every output line. "
            "Valid abbreviations: "
            "AL AK AZ AR CA CO CT DE FL GA HI ID IL IN IA KS KY LA ME MD "
            "MA MI MN MS MO MT NE NV NH NJ NM NY NC ND OH OK OR PA RI SC "
            "SD TN TX UT VT VA WA WV WI WY DC"
        ),
    )
    parser.add_argument(
        "--hamdat", metavar="DB", default=str(HAMDAT_DB_DEFAULT),
        help=f"Path to the hamdat SQLite database (default: {HAMDAT_DB_DEFAULT}). "
             "Only used when --match-state is active.",
    )

    # External alerting
    parser.add_argument(
        "--adif-change-script", metavar="SCRIPT",
        help="Script to execute each time the ADIF log file(s) are reloaded due to a detected "
             "change. The reloaded file path(s) are passed as arguments. Runs non-blocking "
             "immediately after the reload completes.",
    )
    parser.add_argument(
        "--alert-command", metavar="SCRIPT",
        help="Script to execute on NEEDED/MATCH events; the alert message is passed as argument 1. "
             "Duplicate events (same callsign + same flags) are suppressed for this run.",
    )
    parser.add_argument(
        "--alert-ntfy", metavar="TOPIC",
        help="POST NEEDED/MATCH alerts to ntfy.sh topic TOPIC. "
             "Duplicate events are suppressed for this run.",
    )

    # Interactive call prompt
    parser.add_argument(
        "--call", action="store_true",
        help='On NEEDED/MATCH events, ring the terminal bell and prompt '
             '"Do you want to call <callsign>? [Y/n]". '
             "Enter defaults to yes; times out to no after --call-timeout seconds. "
             "Each callsign is prompted (and belled) at most once per run.",
    )
    parser.add_argument(
        "--call-timeout", metavar="SECONDS", type=float, default=15.0,
        help="Seconds to wait for a response to the --call prompt (default: 15).",
    )
    parser.add_argument(
        "--stats", action="store_true",
        help="Print a STATS: summary line after each completed decode cycle showing "
             "total and CQ decode counts plus running averages split by even/odd slot.",
    )
    parser.add_argument(
        "--color", action="store_true",
        help="Colorize output with ANSI escape codes: signal fields dimmed, "
             "callsign bold, entity block cyan, worked contacts green, "
             "NEEDED alerts bold red, MATCH alerts bold yellow.",
    )
    parser.add_argument(
        "--debug", action="store_true",
        help="Dump raw hex + parsed fields of every Decode packet to stderr.",
    )

    args = parser.parse_args()

    # ── cty.dat ───────────────────────────────────────────────────────────────
    cty_path = Path(args.cty)
    if not cty_path.exists():
        try:
            download_cty(cty_path)
        except Exception as exc:
            print(f"[cty.dat] Download failed: {exc}", file=sys.stderr)
            print("[cty.dat] Continuing without entity lookup.", file=sys.stderr)

    cty = CtyDat()
    if cty_path.exists():
        try:
            cty.load(cty_path)
            print(
                f"[cty.dat] Loaded {len(cty._prefixes)} prefixes + "
                f"{len(cty._exact)} exact callsigns from {cty_path}",
                file=sys.stderr,
            )
        except Exception as exc:
            print(f"[cty.dat] Load error: {exc} — entity info will be blank.",
                  file=sys.stderr)
    else:
        print("[cty.dat] File not found — entity info will be blank.", file=sys.stderr)

    # ── hamdat state lookup ───────────────────────────────────────────────────
    state_set: set = set()
    hamdat = None
    if args.match_state:
        try:
            state_set = load_state_set(args.match_state)
        except OSError as exc:
            print(f"[match-state] Cannot read {args.match_state}: {exc}", file=sys.stderr)
            sys.exit(1)
        if not state_set:
            print("[match-state] Warning: no state abbreviations found.", file=sys.stderr)
        else:
            print(
                f"[match-state] {len(state_set)} state(s) active: {', '.join(sorted(state_set))}",
                file=sys.stderr,
            )
        db_path = Path(args.hamdat)
        if not db_path.exists():
            print(
                f"[match-state] hamdat database not found: {db_path}\n"
                "[match-state] Run 'hamdat --pull' to build the database.",
                file=sys.stderr,
            )
            sys.exit(1)
        try:
            hamdat = HamdatLookup(db_path)
            print(f"[match-state] Using hamdat DB: {db_path}", file=sys.stderr)
        except Exception as exc:
            print(f"[match-state] Failed to open hamdat DB: {exc}", file=sys.stderr)
            sys.exit(1)

    # ── ADIF log ──────────────────────────────────────────────────────────────
    adif_log    = None
    adif_paths: list = []
    adif_mtimes: dict = {}
    if args.adif:
        adif_paths = [Path(p) for p in args.adif]
        for p in adif_paths:
            if not p.exists():
                print(f"[adif] File not found: {p}", file=sys.stderr)
                sys.exit(1)
        try:
            adif_log    = AdifLog(adif_paths, cty, hamdat, qsl_only=args.qsl_only)
            adif_mtimes = {p: p.stat().st_mtime for p in adif_paths}
        except Exception as exc:
            print(f"[adif] Failed to load: {exc}", file=sys.stderr)
            sys.exit(1)

        checks = [n for flag, n in [
            (args.need_entity,  "DXCC entity"),
            (args.need_cqz,     "CQ zone"),
            (args.need_country, "country"),
        ] if flag]
        print(
            f"[adif] NEEDED checks active: {', '.join(checks) or 'none (all disabled)'}",
            file=sys.stderr,
        )
        if args.qsl_only:
            print(
                "[adif] QSL-only mode: NEEDED checks require LoTW confirmation "
                "(lotw_qsl_rcvd=Y). Unconfirmed QSOs count as still needed.",
                file=sys.stderr,
            )
        print(
            "[adif] *** NEEDED *** will appear for qualifying contacts.",
            file=sys.stderr,
        )

    # ── Cycle stats tracker ───────────────────────────────────────────────────
    cycle_tracker = CycleTracker() if args.stats else None

    # ── Pattern files ─────────────────────────────────────────────────────────
    call_patterns: list = []
    msg_patterns:  list = []
    if args.match_calls:
        call_patterns = load_regex_patterns(args.match_calls)
        print(
            f"[match-calls] {len(call_patterns)} pattern(s) loaded from "
            f"{', '.join(args.match_calls)}",
            file=sys.stderr,
        )
    if args.match_message:
        msg_patterns = load_regex_patterns(args.match_message)
        print(
            f"[match-message] {len(msg_patterns)} pattern(s) loaded from "
            f"{', '.join(args.match_message)}",
            file=sys.stderr,
        )
    for flag, keyword in ((args.pota, "POTA"), (args.sota, "SOTA"), (args.iota, "IOTA")):
        if flag:
            msg_patterns.append((re.compile(rf"\b{keyword}\b", re.IGNORECASE), None))
            print(f"[match-message] {keyword} pattern active", file=sys.stderr)

    # ── JSON output ───────────────────────────────────────────────────────────
    json_fh = None
    if args.save:
        try:
            json_fh = open(args.save, "a", encoding="utf-8")
            print(f"[save] Appending JSON records to: {args.save}", file=sys.stderr)
        except OSError as exc:
            print(f"[save] Cannot open {args.save}: {exc}", file=sys.stderr)
            sys.exit(1)

    # ── UDP sockets ───────────────────────────────────────────────────────────
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
    except AttributeError:
        pass   # SO_REUSEPORT not available on Windows
    sock.bind((args.host, args.port))

    # Separate unbound socket for sending commands TO WSJT-X.
    # An ephemeral source port avoids SO_REUSEPORT ambiguity — packets sent
    # from this socket route to WSJT-X rather than looping back to ourselves.
    tx_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)

    # ── UDP proxy destinations ────────────────────────────────────────────────
    proxy_dests: list = []
    if args.proxy:
        for part in args.proxy.split(","):
            part = part.strip()
            try:
                proxy_dests.append(("127.0.0.1", int(part)))
            except ValueError:
                print(f"[proxy] Invalid port {part!r} — must be an integer.", file=sys.stderr)
                sys.exit(1)

    # ── Session ───────────────────────────────────────────────────────────────
    session = Session(
        args=args, cty=cty, adif_log=adif_log, json_fh=json_fh,
        call_patterns=call_patterns, msg_patterns=msg_patterns,
        state_set=state_set, hamdat=hamdat, cycle_tracker=cycle_tracker,
        tx_sock=tx_sock,
    )

    # ── Startup banner ────────────────────────────────────────────────────────
    label = "all decodes" if args.raw else "CQ calls only"
    print(f"\nListening on {args.host}:{args.port}  [{label}]", file=sys.stderr)
    if proxy_dests:
        targets = ", ".join(f"localhost:{p}" for _, p in proxy_dests)
        print(f"[proxy] Forwarding all packets to: {targets}", file=sys.stderr)
    if adif_log:
        print(
            f"[adif] {adif_log.total_qsos} QSOs in log.",
            file=sys.stderr,
        )
    if args.call:
        print(
            "[call] Interactive prompt enabled — will ask before calling on "
            "NEEDED/MATCH events.\n"
            "[call] WSJT-X must have Settings → Reporting → "
            "'Accept UDP requests' checked.",
            file=sys.stderr,
        )
    print()
    _print_header(args, has_adif=adif_log is not None)

    # ── Main receive loop ─────────────────────────────────────────────────────
    line_count = 0
    try:
        while True:
            data, wsjt_addr = sock.recvfrom(65535)

            for dest in proxy_dests:
                try:
                    tx_sock.sendto(data, dest)
                except OSError:
                    pass  # non-fatal — listener may not be running yet

            if adif_paths:
                try:
                    new_mtimes = {p: p.stat().st_mtime for p in adif_paths}
                    if new_mtimes != adif_mtimes:
                        adif_mtimes = new_mtimes
                        session.adif_log = AdifLog(adif_paths, cty, hamdat, qsl_only=args.qsl_only)
                        print("[adif] File changed — reloaded.", file=sys.stderr)
                        if args.adif_change_script:
                            try:
                                subprocess.Popen(
                                    [args.adif_change_script] + [str(p) for p in adif_paths]
                                )
                            except Exception as exc:
                                print(f"[adif-change-script] {exc}", file=sys.stderr)
                except OSError:
                    pass

            if session.handle_packet(data, wsjt_addr):
                line_count += 1
                if line_count % _HEADER_EVERY == 0:
                    _print_header(args, has_adif=session.adif_log is not None)
    except KeyboardInterrupt:
        print("\nStopped.", file=sys.stderr)
    finally:
        sock.close()
        tx_sock.close()
        if json_fh:
            json_fh.close()
        if hamdat:
            hamdat.close()


if __name__ == "__main__":
    main()
